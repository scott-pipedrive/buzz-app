{
  "productName": "Spheres",
  "version": "1.0.2",
  "identifier": "com.askbellboy.buzz.preview",
  "build": {
    "beforeBuildCommand": "node scripts/build-goose-acp.mjs && node scripts/build-agent-command.mjs --dev && node scripts/build-buzz-cli.mjs --dev && pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Spheres",
        "dragDropEnabled": false,
        "width": 1200,
        "height": 800,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 24
        },
        "minWidth": 480,
        "minHeight": 400,
        "backgroundThrottling": "disabled"
      }
    ]
  },
  "bundle": {
    "icon": ["icons/spheres/icon.png", "icons/spheres/icon.icns"]
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["spheres"] }
    }
  }
}
